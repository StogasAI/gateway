{
	"name": "@stogas/api",
	"private": true,
	"scripts": {
		"build": "cd transports && GOWORK=off go build -o ../dist/stogas-gateway ./cmd/stogas-gateway",
		"check": "cd transports && GOWORK=off go test ./...",
