# Applied on top of allnoconfig, so every option not listed here stays off.
# The build fails if the final configuration differs from any line below.
CONFIG_EXPERT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_CPU_SUP_AMD=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y

# SEV-SNP guest and attestation reports through /dev/sev-guest
CONFIG_AMD_MEM_ENCRYPT=y
CONFIG_VIRT_DRIVERS=y
CONFIG_SEV_GUEST=y

# System calls that the Go runtime, glibc and ntpd-rs need. ntpd-rs steers the
# clock with clock_adjtime, which comes with POSIX timers.
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_POSIX_TIMERS=y

# Mitigations for CPU vulnerabilities on AMD processors
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_TSA=y

# Hardening. A kernel error ends the guest, like a gateway exit does.
CONFIG_BUG=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_X86_UMIP=y

# UEFI boot of the unified kernel image with a compressed initramfs. The
# initramfs root is tmpfs, which limits its size to half of memory. EFI
# runtime services stay off, so no firmware code runs after boot.
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_DISABLE_RUNTIME=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_BINFMT_ELF=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y

# Serial console with kernel messages
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y

# Virtio network with kernel DHCP, which also writes /proc/net/pnp
CONFIG_PCI=y
CONFIG_PCI_DIRECT=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
# CONFIG_VIRTIO_PCI_LEGACY is not set
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

# Interfaces that init and the gateway use: deployment settings in fw_cfg,
# the ACPI power button for shutdown, and memory pressure in /proc/pressure
CONFIG_FW_CFG_SYSFS=y
CONFIG_ACPI_BUTTON=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Options that must stay off
# CONFIG_BINFMT_MISC is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_FTRACE is not set
# CONFIG_FW_LOADER is not set
# CONFIG_HIBERNATION is not set
# CONFIG_IO_URING is not set
# CONFIG_KALLSYMS is not set
# CONFIG_KEXEC is not set
# CONFIG_KPROBES is not set
# CONFIG_MODULES is not set
# CONFIG_PACKET is not set
# CONFIG_PROFILING is not set
# CONFIG_USER_NS is not set
