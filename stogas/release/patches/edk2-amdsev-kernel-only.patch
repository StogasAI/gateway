diff --git a/OvmfPkg/AmdSev/AcpiTables/AcpiTables.h b/OvmfPkg/AmdSev/AcpiTables/AcpiTables.h
new file mode 100644
index 0000000..5024350
--- /dev/null
+++ b/OvmfPkg/AmdSev/AcpiTables/AcpiTables.h
@@ -0,0 +1,26 @@
+/** @file
+  Header fields shared by the fixed ACPI tables.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef AMD_SEV_ACPI_TABLES_H_
+#define AMD_SEV_ACPI_TABLES_H_
+
+#include <IndustryStandard/Acpi.h>
+
+//
+// AcpiPlatformDxe computes the checksum when it installs the table.
+//
+#define ACPI_TABLE_HEADER(Sig, Type, Rev)  {                        \
+    .Signature       = (Sig),                                       \
+    .Length          = sizeof (Type),                               \
+    .Revision        = (Rev),                                       \
+    .OemId           = { 'S', 'T', 'O', 'G', 'A', 'S' },            \
+    .OemTableId      = SIGNATURE_64 ('G', 'A', 'T', 'E', 'W', 'A', 'Y', ' '), \
+    .OemRevision     = 1,                                           \
+    .CreatorId       = SIGNATURE_32 ('S', 'T', 'G', 'S'),           \
+    .CreatorRevision = 1,                                           \
+  }
+
+#endif
diff --git a/OvmfPkg/AmdSev/AcpiTables/AcpiTables.inf b/OvmfPkg/AmdSev/AcpiTables/AcpiTables.inf
new file mode 100644
index 0000000..2230313
--- /dev/null
+++ b/OvmfPkg/AmdSev/AcpiTables/AcpiTables.inf
@@ -0,0 +1,24 @@
+## @file
+#  Fixed ACPI tables for the AmdSev guest, which replace the tables that QEMU
+#  would supply. AcpiPlatformDxe installs them from this module's FFS file.
+#
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+#
+##
+
+[Defines]
+  INF_VERSION                    = 1.29
+  BASE_NAME                      = AmdSevAcpiTables
+  FILE_GUID                      = 769B8161-A741-4B55-A8AC-1B649A245EE4
+  MODULE_TYPE                    = USER_DEFINED
+  VERSION_STRING                 = 1.0
+
+[Sources]
+  AcpiTables.h
+  Dsdt.asl
+  Facp.aslc
+  Facs.aslc
+  Madt.aslc
+
+[Packages]
+  MdePkg/MdePkg.dec
diff --git a/OvmfPkg/AmdSev/AcpiTables/Dsdt.asl b/OvmfPkg/AmdSev/AcpiTables/Dsdt.asl
new file mode 100644
index 0000000..d62d642
--- /dev/null
+++ b/OvmfPkg/AmdSev/AcpiTables/Dsdt.asl
@@ -0,0 +1,52 @@
+/** @file
+  Differentiated System Description Table (DSDT).
+
+  It describes only what the kernel uses: the PCI root bridge with the windows
+  where OVMF places BARs, the fw_cfg device, and the S5 sleep type for power
+  off. PCI devices use MSI-X, so there is no interrupt routing.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+DefinitionBlock ("Dsdt.aml", "DSDT", 2, "STOGAS", "GATEWAY", 1)
+{
+  Scope (\_SB) {
+    Device (PCI0) {
+      Name (_HID, EisaId ("PNP0A03"))
+      Name (_UID, 0)
+      Name (_CRS, ResourceTemplate () {
+        WordBusNumber (ResourceProducer, MinFixed, MaxFixed, PosDecode,
+          0x0000, 0x0000, 0x00FF, 0x0000, 0x0100)
+        IO (Decode16, 0x0CF8, 0x0CF8, 0x01, 0x08)
+        WordIO (ResourceProducer, MinFixed, MaxFixed, PosDecode, EntireRange,
+          0x0000, 0x0000, 0x0CF7, 0x0000, 0x0CF8)
+        WordIO (ResourceProducer, MinFixed, MaxFixed, PosDecode, EntireRange,
+          0x0000, 0x0D00, 0xFFFF, 0x0000, 0xF300)
+        //
+        // From the end of the 2 GiB of low memory to the PCIe configuration
+        // space at 0xE0000000
+        //
+        DWordMemory (ResourceProducer, PosDecode, MinFixed, MaxFixed,
+          NonCacheable, ReadWrite,
+          0x00000000, 0x80000000, 0xDFFFFFFF, 0x00000000, 0x60000000)
+        //
+        // From the end of the 16 GiB of memory, at 18 GiB, to the top of a
+        // 48-bit address space. The kernel limits this window to the guest's
+        // physical address width.
+        //
+        QWordMemory (ResourceProducer, PosDecode, MinFixed, MaxFixed,
+          Cacheable, ReadWrite,
+          0x0, 0x480000000, 0xFFFFFFFFFFFF, 0x0, 0xFFFB80000000)
+      })
+
+      Device (FWCF) {
+        Name (_HID, "QEMU0002")
+        Name (_CRS, ResourceTemplate () {
+          IO (Decode16, 0x0510, 0x0510, 0x01, 0x0C)
+        })
+      }
+    }
+  }
+
+  Name (_S5, Package () { 0, 0, 0, 0 })
+}
diff --git a/OvmfPkg/AmdSev/AcpiTables/Facp.aslc b/OvmfPkg/AmdSev/AcpiTables/Facp.aslc
new file mode 100644
index 0000000..a2360e0
--- /dev/null
+++ b/OvmfPkg/AmdSev/AcpiTables/Facp.aslc
@@ -0,0 +1,45 @@
+/** @file
+  Fixed ACPI Description Table (FADT).
+
+  The ICH9 power management registers at ICH9_PMBASE_VALUE provide the SCI on
+  IRQ 9, the power button, S5 power off, and the 24-bit PM timer that the
+  kernel measures the TSC frequency against. SMI_CMD is zero because there is
+  no SMM, so the guest is always in ACPI mode. There is no GPE block or reset
+  register. AcpiTableDxe fills in the FACS and DSDT addresses.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "AcpiTables.h"
+
+EFI_ACPI_6_6_FIXED_ACPI_DESCRIPTION_TABLE  Fadt = {
+  .Header = ACPI_TABLE_HEADER (
+              EFI_ACPI_6_6_FIXED_ACPI_DESCRIPTION_TABLE_SIGNATURE,
+              EFI_ACPI_6_6_FIXED_ACPI_DESCRIPTION_TABLE,
+              EFI_ACPI_6_6_FIXED_ACPI_DESCRIPTION_TABLE_REVISION
+              ),
+  .SciInt       = 9,
+  .Pm1aEvtBlk   = 0x600,
+  .Pm1aCntBlk   = 0x604,
+  .PmTmrBlk     = 0x608,
+  .Pm1EvtLen    = 4,
+  .Pm1CntLen    = 2,
+  .PmTmrLen     = 4,
+  .PLvl2Lat     = 0x0FFF,                   // No C2 state
+  .PLvl3Lat     = 0x0FFF,                   // No C3 state
+  .Century      = 0x32,
+  //
+  // SLP_BUTTON says there is no sleep button. PWR_BUTTON stays clear, so the
+  // power button is the fixed hardware one in the PM1 registers.
+  //
+  .Flags        = EFI_ACPI_6_6_WBINVD | EFI_ACPI_6_6_PROC_C1 | EFI_ACPI_6_6_SLP_BUTTON,
+  .MinorVersion = EFI_ACPI_6_6_FIXED_ACPI_DESCRIPTION_TABLE_MINOR_REVISION,
+};
+
+VOID *
+ReferenceAcpiTable (
+  VOID
+  )
+{
+  return &Fadt;
+}
diff --git a/OvmfPkg/AmdSev/AcpiTables/Facs.aslc b/OvmfPkg/AmdSev/AcpiTables/Facs.aslc
new file mode 100644
index 0000000..1803555
--- /dev/null
+++ b/OvmfPkg/AmdSev/AcpiTables/Facs.aslc
@@ -0,0 +1,25 @@
+/** @file
+  Firmware ACPI Control Structure (FACS).
+
+  AcpiPlatformDxe writes a checksum into byte 9 of every table it installs.
+  In the FACS, that byte is part of HardwareSignature, which only matters when
+  resuming from hibernation.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "AcpiTables.h"
+
+EFI_ACPI_6_6_FIRMWARE_ACPI_CONTROL_STRUCTURE  Facs = {
+  .Signature = EFI_ACPI_6_6_FIRMWARE_ACPI_CONTROL_STRUCTURE_SIGNATURE,
+  .Length    = sizeof (EFI_ACPI_6_6_FIRMWARE_ACPI_CONTROL_STRUCTURE),
+  .Version   = EFI_ACPI_6_6_FIRMWARE_ACPI_CONTROL_STRUCTURE_VERSION,
+};
+
+VOID *
+ReferenceAcpiTable (
+  VOID
+  )
+{
+  return &Facs;
+}
diff --git a/OvmfPkg/AmdSev/AcpiTables/Madt.aslc b/OvmfPkg/AmdSev/AcpiTables/Madt.aslc
new file mode 100644
index 0000000..cc4d1f5
--- /dev/null
+++ b/OvmfPkg/AmdSev/AcpiTables/Madt.aslc
@@ -0,0 +1,74 @@
+/** @file
+  Multiple APIC Description Table (MADT) for the four vCPUs in the IGVM file,
+  with APIC IDs 0 to 3, and the q35 I/O APIC.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "AcpiTables.h"
+
+#define LOCAL_APIC(Id)  {                                                  \
+    .Type             = EFI_ACPI_6_6_PROCESSOR_LOCAL_APIC,                 \
+    .Length           = sizeof (EFI_ACPI_6_6_PROCESSOR_LOCAL_APIC_STRUCTURE), \
+    .AcpiProcessorUid = (Id),                                              \
+    .ApicId           = (Id),                                              \
+    .Flags            = EFI_ACPI_6_6_LOCAL_APIC_ENABLED,                   \
+  }
+
+#define INTERRUPT_SOURCE_OVERRIDE(Irq, Gsi, IntiFlags)  {                  \
+    .Type                  = EFI_ACPI_6_6_INTERRUPT_SOURCE_OVERRIDE,       \
+    .Length                = sizeof (EFI_ACPI_6_6_INTERRUPT_SOURCE_OVERRIDE_STRUCTURE), \
+    .Source                = (Irq),                                        \
+    .GlobalSystemInterrupt = (Gsi),                                        \
+    .Flags                 = (IntiFlags),                                  \
+  }
+
+#pragma pack (1)
+typedef struct {
+  EFI_ACPI_6_6_MULTIPLE_APIC_DESCRIPTION_TABLE_HEADER    Header;
+  EFI_ACPI_6_6_PROCESSOR_LOCAL_APIC_STRUCTURE            LocalApic[4];
+  EFI_ACPI_6_6_IO_APIC_STRUCTURE                         IoApic;
+  EFI_ACPI_6_6_INTERRUPT_SOURCE_OVERRIDE_STRUCTURE       InterruptSourceOverride[2];
+} AMD_SEV_MADT;
+#pragma pack ()
+
+AMD_SEV_MADT  Madt = {
+  .Header = {
+    .Header = ACPI_TABLE_HEADER (
+                EFI_ACPI_6_6_MULTIPLE_APIC_DESCRIPTION_TABLE_SIGNATURE,
+                AMD_SEV_MADT,
+                EFI_ACPI_6_6_MULTIPLE_APIC_DESCRIPTION_TABLE_REVISION
+                ),
+    .LocalApicAddress = 0xFEE00000,
+    .Flags            = EFI_ACPI_6_6_PCAT_COMPAT,
+  },
+  .LocalApic = {
+    LOCAL_APIC (0),
+    LOCAL_APIC (1),
+    LOCAL_APIC (2),
+    LOCAL_APIC (3),
+  },
+  .IoApic = {
+    .Type          = EFI_ACPI_6_6_IO_APIC,
+    .Length        = sizeof (EFI_ACPI_6_6_IO_APIC_STRUCTURE),
+    .IoApicAddress = 0xFEC00000,
+  },
+  .InterruptSourceOverride = {
+    //
+    // The PIT on ISA IRQ 0 is wired to I/O APIC input 2.
+    //
+    INTERRUPT_SOURCE_OVERRIDE (0, 2, 0),
+    //
+    // The SCI is active high (bits 1:0 = 01) and level triggered (bits 3:2 = 11).
+    //
+    INTERRUPT_SOURCE_OVERRIDE (9, 9, 0x000D),
+  },
+};
+
+VOID *
+ReferenceAcpiTable (
+  VOID
+  )
+{
+  return &Madt;
+}
