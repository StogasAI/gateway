+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use igvm::{IgvmPlatformHeader, IgvmRevision};
+    use igvm_defs::IGVM_VHS_SUPPORTED_PLATFORM;
+    use zerocopy::FromZeros;
+
+    const KVM_VMSA_GPA: u64 = 0xFFFFFFFFF000;
+
+    fn kvm_measure() -> IgvmMeasure {
+        IgvmMeasure {
+            show_progress: false,
+            check_kvm: true,
+            native_zero: false,
+            digest: vec![],
+            last_page_type: SnpPageType::None,
+            last_gpa: 0,
+            last_next_gpa: 0,
+            last_len: 0,
+            compatibility_mask: 1,
+            vmsa_count: 0,
+            id_block_ld: None,
+            platform: IgvmPlatformType::SEV_SNP,
+        }
+    }
+
+    fn valid_vmsa() -> SevVmsa {
+        let mut vmsa = SevVmsa::new_zeroed();
+        vmsa.cr0 = 0x30;
+        vmsa
+    }
+
+    fn vmsa_directive(vp_index: u16) -> IgvmDirectiveHeader {
+        IgvmDirectiveHeader::SnpVpContext {
+            gpa: KVM_VMSA_GPA,
+            compatibility_mask: 1,
+            vp_index,
+            vmsa: Box::new(valid_vmsa()),
+        }
+    }
+
+    fn snp_file(directives: Vec<IgvmDirectiveHeader>) -> IgvmFile {
+        let platform = IgvmPlatformHeader::SupportedPlatform(IGVM_VHS_SUPPORTED_PLATFORM {
+            compatibility_mask: 1,
+            highest_vtl: 0,
+            platform_type: IgvmPlatformType::SEV_SNP,
+            platform_version: 1,
+            shared_gpa_boundary: 0,
+        });
+        IgvmFile::new(IgvmRevision::V1, vec![platform], vec![], directives).unwrap()
+    }
+
+    #[test]
+    fn kvm_check_requires_contiguous_vp_indexes() {
+        let mut measure = kvm_measure();
+        let vmsa = valid_vmsa();
+
+        assert!(measure.check_vmsa(0, &vmsa).is_ok());
+        measure.vmsa_count = 1;
+        assert!(measure.check_vmsa(1, &vmsa).is_ok());
+        assert!(matches!(
+            measure.check_vmsa(2, &vmsa),
+            Err(KvmCheckError::InvalidVmsaVpIndex(1, 2))
+        ));
+    }
+
+    #[test]
+    fn kvm_check_rejects_invalid_cr0() {
+        let mut vmsa = valid_vmsa();
+        vmsa.cr0 = 0;
+        assert!(matches!(
+            kvm_measure().check_vmsa(0, &vmsa),
+            Err(KvmCheckError::InvalidVmsaCr0(0))
+        ));
+    }
+
+    #[test]
+    fn kvm_check_rejects_pages_after_vmsas() {
+        let page = IgvmDirectiveHeader::PageData {
+            gpa: 0,
+            compatibility_mask: 1,
+            flags: IgvmPageDataFlags::new(),
+            data_type: IgvmPageDataType::NORMAL,
+            data: vec![],
+        };
+        let igvm = snp_file(vec![vmsa_directive(0), page]);
+        let error = IgvmMeasure::measure(false, true, false, 1, IgvmPlatformType::SEV_SNP, &igvm)
+            .unwrap_err();
+
+        assert!(matches!(
+            error.downcast_ref::<IgvmMeasureError>(),
+            Some(IgvmMeasureError::KvmCheckFailed(
+                KvmCheckError::InvalidVmsaOrder
+            ))
+        ));
+    }
+
+    #[test]
+    fn kvm_check_accepts_ordered_vmsa_suffix() {
+        let igvm = snp_file((0..4).map(vmsa_directive).collect());
+        let measure =
+            IgvmMeasure::measure(false, true, false, 1, IgvmPlatformType::SEV_SNP, &igvm).unwrap();
+
+        assert_eq!(measure.vmsa_count, 4);
+    }
+
+    #[test]
+    fn kvm_measurement_normalizes_typed_vmsa_fields() {
+        let mut measure = kvm_measure();
+        let mut ctx = IgvmMeasureContext::default();
+        let vmsa = valid_vmsa();
+
+        measure
+            .measure_vmsa(&mut ctx, KVM_VMSA_GPA, 1, 0, &vmsa)
+            .unwrap();
+
+        let mut normalized = vmsa;
+        normalized.cr4 |= 1 << 6;
+        normalized.rflags |= 1 << 1;
+        let mut normalized_page = normalized.as_bytes().to_vec();
+        normalized_page.resize(PAGE_SIZE_4K as usize, 0);
+        let expected =
+            PageInfo::new_vmsa_page([0; 48], KVM_VMSA_GPA, &normalized_page).update_hash();
+
+        assert_eq!(ctx.digest_snp, expected);
+        assert_eq!(measure.vmsa_count, 1);
+        assert_eq!(vmsa.cr4, 0);
+        assert_eq!(vmsa.rflags, 0);
+    }
+}
