 #[test]
 fn test_real_mode() {
     let features = SevFeatures::new();
     let regs = real_mode_regs();
     let _ = native_context(&regs);
-    let _ = vmsa_context(&regs, features);
+    let vmsa = vmsa_context(&regs, features);
+    assert_eq!(vmsa.cr0, 0x30);
+    assert_eq!(vmsa.rip, 0xfff0);
+    assert_eq!(vmsa.cs.base, 0xffff0000);
+}
+
+#[test]
+fn test_sev_ap_reset() {
+    let features = SevFeatures::new();
+    let regs = sev_ap_reset_regs(0x1234fff0);
+    let vmsa = vmsa_context(&regs, features);
+    assert_eq!(vmsa.cr0, 0x30);
+    assert_eq!(vmsa.rip, 0xfff0);
+    assert_eq!(vmsa.cs.base, 0x12340000);
 }
 
