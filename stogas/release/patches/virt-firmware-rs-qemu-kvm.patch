diff --git a/igvm-tools/tests/builder.rs b/igvm-tools/tests/builder.rs
new file mode 100644
index 0000000..b473c62
--- /dev/null
+++ b/igvm-tools/tests/builder.rs
@@ -0,0 +1,34 @@
+use igvm::IgvmDirectiveHeader;
+
+use virtfw_igvm_tools::builder::Builder;
+use virtfw_igvm_tools::x86regs::{real_mode_regs, sev_ap_reset_regs};
+
+#[test]
+fn test_snp_vmsas_are_ordered_suffix() {
+    let mut builder = Builder::new();
+    builder.add_snp_platform();
+    for vp_index in [2, 0, 3, 1] {
+        let regs = if vp_index == 0 {
+            real_mode_regs()
+        } else {
+            sev_ap_reset_regs(0x1234fff0)
+        };
+        builder.add_snp_vmsa_context(&regs, vp_index, false);
+    }
+    builder.add_data_pages(0x1000, &[0; 0x2000]);
+
+    let igvm = builder.finalize().unwrap();
+    let directives = igvm.directives();
+    let vmsa_start = directives.len() - 4;
+    assert!(directives[..vmsa_start]
+        .iter()
+        .all(|d| matches!(d, IgvmDirectiveHeader::PageData { .. })));
+    let vp_indexes: Vec<u16> = directives[vmsa_start..]
+        .iter()
+        .map(|d| match d {
+            IgvmDirectiveHeader::SnpVpContext { vp_index, .. } => *vp_index,
+            _ => panic!("expected an SNP VMSA"),
+        })
+        .collect();
+    assert_eq!(vp_indexes, [0, 1, 2, 3]);
+}
